{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Medora: run website",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "Start MySQL",
      "justMyCode": true,
      "serverReadyAction": { "pattern": "Uvicorn running on", "uriFormat": "http://localhost:8000/welcome", "action": "openExternally" }
    },
    {
      "name": "Medora: run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "tests"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    }
  ]
}
